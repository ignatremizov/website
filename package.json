{
  "name": "ignat-portfolio-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "npm run check:build && node scripts/update-performance-budget.mjs",
    "check:build": "node scripts/check-build.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test --test-concurrency=2 tests/*.test.mjs",
    "check": "npm run type-check && npm run test:unit",
    "art:falls": "node --experimental-strip-types scripts/export-falls-reference.mjs",
    "update:performance-budget": "node scripts/update-performance-budget.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.4"
  }
}
